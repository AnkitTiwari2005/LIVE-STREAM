# ==============================================================================
# Param Darshan - Pooja & Astrology Live Streaming Platform
# Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Node Runtime
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
DOMAIN=replace_with_your_domain.com
FRONTEND_ORIGIN=https://replace_with_your_domain.com
NEXT_PUBLIC_API_URL=https://replace_with_your_domain.com/api/v1
NEXT_PUBLIC_BOOKINGS_ENABLED=false

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL / Neon Lakebase)
# ------------------------------------------------------------------------------
# Pooled connection string (pgBouncer) for standard NestJS REST & WebSocket API traffic
# Uses the least-privilege pooja_app application role (not postgres superuser)
DATABASE_URL=postgresql://pooja_app:replace_with_secure_app_password@postgres:5432/pooja?schema=public&connection_limit=10

# Direct unpooled connection string for Prisma runtime/health checks
DATABASE_URL_UNPOOLED=postgresql://pooja_app:replace_with_secure_app_password@postgres:5432/pooja?schema=public

# Optional: Maximum database connection pool size per application worker (defaults to 5 if unset, recommended: 10)
DB_CONNECTION_LIMIT=10

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_DB=pooja
APP_DB_USER=pooja_app
APP_DB_PASSWORD=replace_with_secure_app_password

# ------------------------------------------------------------------------------
# 3. Redis Cache & Socket.IO State Adapter
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=replace_with_secure_redis_password

# ------------------------------------------------------------------------------
# 4. Security, JWT & Cryptographic Keys
# ------------------------------------------------------------------------------
ENCRYPTION_MASTER_KEY=generate_with_openssl_rand_base64_32
JWT_ACCESS_SECRET=replace_with_strong_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_strong_jwt_refresh_secret_min_32_chars
JWT_2FA_SECRET=replace_with_strong_jwt_2fa_secret_min_32_chars
INTERNAL_KEY=replace_with_internal_secret_key_min_32_chars

# ------------------------------------------------------------------------------
# 5. LiveKit SFU Video Server (WebRTC Streaming)
# ------------------------------------------------------------------------------
LIVEKIT_HOST=http://localhost:7880
LIVEKIT_URL=http://livekit:7880
LIVEKIT_PUBLIC_URL=wss://live.replace_with_your_domain.com
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_secure_livekit_api_secret_min_32_chars
NEXT_PUBLIC_LIVEKIT_URL=wss://live.replace_with_your_domain.com

# ------------------------------------------------------------------------------
# 6. Razorpay Payments & Webhook Security
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_replace_with_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
# B-29: Mock payments guard - set to true ONLY for local dev/staging without Razorpay credentials
ALLOW_MOCK_PAYMENTS=false

# ------------------------------------------------------------------------------
# 7. Initial Admin Credentials (Seeding)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@replace_with_your_domain.com
ADMIN_BOOTSTRAP_PASSWORD=replace_with_strong_admin_initial_password

# ------------------------------------------------------------------------------
# 8. Transactional Email Delivery (Brevo / Resend SMTP API)
# ------------------------------------------------------------------------------
BREVO_API_KEY=xkeysib-replace_with_brevo_transactional_api_key
RESEND_API_KEY=re_replace_with_resend_api_key
EMAIL_FROM_ADDRESS=notifications@replace_with_your_domain.com
EMAIL_FROM_NAME="Param Darshan Live"
# Optional second channel, used when the REST key above is empty or Brevo's API is unreachable (SMTP relay)
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587

# ------------------------------------------------------------------------------
# 9. Google OAuth Sign-In (Optional)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_CALLBACK_URL=https://replace_with_your_domain.com/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# 10. Background Jobs & Crons
# ------------------------------------------------------------------------------
# Set to true for single-process hosting (Hostinger/Passenger: no separate worker) - the stream watchdog,
# coin-meter watchdog, reminders and retention jobs ONLY run when this is not 'false'.
# docker-compose overrides it per service (api=false, worker=true), so leave true here.
RUN_CRONS=true

# ------------------------------------------------------------------------------
# 11. Cloudflare R2 / S3 Object Storage (Media Assets & VODs)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=replace_with_cloudflare_account_id
R2_ACCESS_KEY=replace_with_r2_access_key
R2_SECRET_KEY=replace_with_r2_secret_key
R2_BUCKET=pooja-live-assets
R2_PUBLIC_URL=https://assets.replace_with_your_domain.com

# ------------------------------------------------------------------------------
# 12. Backups, Monitoring & Error Tracking
# ------------------------------------------------------------------------------
BACKUP_PUBLIC_KEY=age1replace_with_your_age_public_key_generated_via_age_keygen
HEALTHCHECK_BACKUP_URL=https://hc-ping.com/replace-with-uuid
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/replace_or_slack_webhook
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Kundli (Vedic birth chart) - powered by the AstroLogics API. Optional: with no key the /kundli
# page shows "being set up" and nothing else changes. Keep the key on the server only.
# ---------------------------------------------------------------------------
ASTROLOGICS_API_KEY=
# Free plan = 2 requests/second and 2 in flight. Raise these only after upgrading the plan.
ASTROLOGICS_MAX_RPS=2
ASTROLOGICS_MAX_CONCURRENCY=2
# Stop after this many credits per UTC day (a full kundli = 5, a chart drawing = 2). 0 = no ceiling.
KUNDLI_DAILY_CREDIT_CAP=100
