# ==============================================================================
# Shubhdarshan - Pooja & Astrology Live Streaming Platform
# ==============================================================================
# COPY TO .env.production ON SERVER (chmod 600 .env.production)
# DO NOT COMMIT ACTUAL SECRETS TO SOURCE CONTROL

# ------------------------------------------------------------------------------
# 1. Database Credentials (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Admin role used exclusively for migrations and administrative setup
POSTGRES_USER=pooja_admin
POSTGRES_PASSWORD=replace_with_super_secure_postgres_admin_password_min_32_chars
POSTGRES_DB=pooja_live

# Limited application role used by the api and worker services (no drop/truncate/schema change rights)
APP_DB_USER=pooja_app
APP_DB_PASSWORD=replace_with_secure_app_user_password_min_24_chars

# Direct connection URLs (Internal Docker Bridge)
DATABASE_URL=postgresql://${APP_DB_USER}:${APP_DB_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public
ADMIN_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# ------------------------------------------------------------------------------
# 2. Redis Configuration
# ------------------------------------------------------------------------------
REDIS_PASSWORD=replace_with_secure_redis_auth_token_min_32_chars
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ------------------------------------------------------------------------------
# 3. LiveKit SFU & Media Server
# ------------------------------------------------------------------------------
LIVEKIT_API_KEY=pooja
LIVEKIT_API_SECRET=replace_with_secure_livekit_api_secret_min_32_chars
LIVEKIT_HOST=http://livekit:7880
NEXT_PUBLIC_LIVEKIT_URL=wss://live.platform-domain.com

# ------------------------------------------------------------------------------
# 4. Encryption & Security Secrets
# ------------------------------------------------------------------------------
# 32-byte AES-256-GCM key in Base64 (generate via: openssl rand -base64 32)
ENCRYPTION_MASTER_KEY=generate_with_openssl_rand_base64_32

# JWT Secret Keys
JWT_ACCESS_SECRET=replace_with_strong_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_strong_jwt_refresh_secret_min_32_chars

# Internal communication key between host scripts and API
INTERNAL_KEY=replace_with_internal_secret_key_min_32_chars

# ------------------------------------------------------------------------------
# 5. Domain, CORS & Networking
# ------------------------------------------------------------------------------
FRONTEND_ORIGIN=https://platform-domain.com
NEXT_PUBLIC_API_URL=https://platform-domain.com/api/v1
DOMAIN=platform-domain.com

# ------------------------------------------------------------------------------
# 6. OAuth Providers (Google Sign-In)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_CALLBACK_URL=https://platform-domain.com/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# 7. Transactional Email Delivery (Brevo)
# ------------------------------------------------------------------------------
BREVO_API_KEY=xkeysib-replace_with_brevo_transactional_api_key
EMAIL_FROM_ADDRESS=notifications@platform-domain.com
EMAIL_FROM_NAME="Shubhdarshan Live"

# ------------------------------------------------------------------------------
# 8. Object Storage & Backups (Cloudflare R2 / S3-Compatible)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=replace_with_cloudflare_account_id
R2_ACCESS_KEY=replace_with_r2_access_key_id
R2_SECRET_KEY=replace_with_r2_secret_access_key
R2_BUCKET=pooja-live-assets
R2_PUBLIC_URL=https://assets.platform-domain.com

# Backup Encryption (age public key)
BACKUP_PUBLIC_KEY=age1replace_with_your_age_public_key_generated_via_age_keygen

# Monitoring & Healthchecks
HEALTHCHECK_BACKUP_URL=https://hc-ping.com/replace-with-uuid
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/replace_or_slack_webhook
SENTRY_DSN=
