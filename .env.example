# ==============================================================================
# Shubhdarshan - Pooja & Astrology Live Streaming Platform
# Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Node Runtime
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
DOMAIN=darkturquoise-louse-359917.hostingersite.com
FRONTEND_ORIGIN=https://darkturquoise-louse-359917.hostingersite.com
NEXT_PUBLIC_API_URL=https://darkturquoise-louse-359917.hostingersite.com/api/v1

# ------------------------------------------------------------------------------
# 2. Database Connection (Neon Lakebase PostgreSQL)
# ------------------------------------------------------------------------------
# Pooled connection string (pgBouncer) for standard NestJS REST & WebSocket API traffic
DATABASE_URL=postgresql://neondb_owner:password@ep-restless-haze-b38asyjn-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# Direct unpooled connection string for Prisma migrations & schema changes
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:password@ep-restless-haze-b38asyjn.c-4.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require

NEON_BRANCH=production
POSTGRES_USER=neondb_owner
POSTGRES_DB=neondb
APP_DB_USER=neondb_owner

# ------------------------------------------------------------------------------
# 3. Redis Cache & Socket.IO State Adapter
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Security, JWT & Cryptographic Keys
# ------------------------------------------------------------------------------
ENCRYPTION_MASTER_KEY=generate_with_openssl_rand_base64_32
JWT_ACCESS_SECRET=replace_with_strong_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_strong_jwt_refresh_secret_min_32_chars
INTERNAL_KEY=replace_with_internal_secret_key_min_32_chars

# ------------------------------------------------------------------------------
# 5. LiveKit SFU Video Server (WebRTC Streaming)
# ------------------------------------------------------------------------------
LIVEKIT_HOST=http://localhost:7880
LIVEKIT_API_KEY=pooja
LIVEKIT_API_SECRET=replace_with_secure_livekit_api_secret_min_32_chars
NEXT_PUBLIC_LIVEKIT_URL=wss://live.platform-domain.com

# ------------------------------------------------------------------------------
# 6. Transactional Email Delivery (Brevo SMTP API)
# ------------------------------------------------------------------------------
BREVO_API_KEY=xkeysib-replace_with_brevo_transactional_api_key
EMAIL_FROM_ADDRESS=notifications@shubhdarshan.com
EMAIL_FROM_NAME="Shubhdarshan Live"

# ------------------------------------------------------------------------------
# 7. Google OAuth Sign-In (Optional)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_CALLBACK_URL=https://darkturquoise-louse-359917.hostingersite.com/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# 8. Background Jobs & Crons
# ------------------------------------------------------------------------------
RUN_CRONS=false

# ------------------------------------------------------------------------------
# 9. Cloudflare R2 / S3 Object Storage (Media Assets & VODs)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=replace_with_cloudflare_account_id
R2_ACCESS_KEY=replace_with_r2_access_key
R2_SECRET_KEY=replace_with_r2_secret_key
R2_BUCKET=pooja-live-assets
R2_PUBLIC_URL=https://assets.shubhdarshan.com

# ------------------------------------------------------------------------------
# 10. Backups, Monitoring & Error Tracking
# ------------------------------------------------------------------------------
BACKUP_PUBLIC_KEY=age1replace_with_your_age_public_key_generated_via_age_keygen
HEALTHCHECK_BACKUP_URL=https://hc-ping.com/replace-with-uuid
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/replace_or_slack_webhook
SENTRY_DSN=
